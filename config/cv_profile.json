{
  "agent_config": {
    "file_extension": ".pdf",
    "prefix": "CV",
    "experience": "20",
    "owner": "Jesus_Coronado",
    "naming_format": "{prefix}_{exp}_{city}_{role}_{tech}_{lang}_{owner}{ext}"
  },
  "rules": {
    "city_mapping": {
      "bogota": "B",
      "medellin": "M",
      "__default__": "M"
