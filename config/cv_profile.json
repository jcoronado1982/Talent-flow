        "lead",
        "lider",
        "l\u00edder",
        "architect",
        "arquitecto",
        "manager",
        "staff",
        "principal",
        "head",
        "especialista",
        "supervisor",
        "coordinador",
        "gerente",
        "director",
        "jefe"
      ],
      "codes": {
        "leader": "L",
        "developer": "D"
      }
    },
    "tech_mapping": {
      "J": [
        "java",
        "spring",
        "hibernate",
        "jvm",
        "maven",
        "jpa"
      ],
      "C": [
        "c#",
